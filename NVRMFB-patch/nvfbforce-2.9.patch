+static void nvrmForce(struct NvKmsKapiDynamicDisplayParams *dd)
+{
+    if (!gForcedDpy || dd->handle != gForcedDpy) return;
+    if (gKms && gDev) {
+        struct NvKmsKapiDynamicDisplayParams *p =
+            (struct NvKmsKapiDynamicDisplayParams *)IOMalloc(sizeof *p);
+        if (p) {
+            nvu_zero(p, sizeof *p);
+            p->handle = dd->handle;
+            const NvBool realConnected = gKms->getDynamicDisplayInfo(gDev, p) && p->connected;
+            IOFree(p, sizeof *p);
+            if (realConnected) return;
+        }
+    }
+    dd->forceConnected = NV_TRUE; dd->overrideEdid = NV_TRUE;
+    dd->edid.bufferSize = sizeof kForcedEdid; nvu_copy(dd->edid.buffer, kForcedEdid, sizeof kForcedEdid);
